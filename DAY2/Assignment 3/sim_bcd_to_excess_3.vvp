#! /mingw64/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "C:\msys64\mingw64\lib\ivl\system.vpi";
:vpi_module "C:\msys64\mingw64\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\msys64\mingw64\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\msys64\mingw64\lib\ivl\v2005_math.vpi";
:vpi_module "C:\msys64\mingw64\lib\ivl\va_math.vpi";
S_00000200a60fae30 .scope module, "bcd_to_excess_3_dataflow_tb" "bcd_to_excess_3_dataflow_tb" 2 8;
 .timescale -9 -12;
v00000200a6148d70_0 .var "bcd", 3 0;
v00000200a6148690_0 .var/i "bcd_value", 31 0;
v00000200a6148b90_0 .net "excess_3", 3 0, L_00000200a6148550;  1 drivers
v00000200a61485f0_0 .var "expected_excess_3", 3 0;
v00000200a6149130_0 .var/i "failure_count", 31 0;
v00000200a6148eb0_0 .var/i "test_count", 31 0;
S_00000200a60f86e0 .scope module, "dut" "bcd_to_excess_3_dataflow" 2 18, 3 6 0, S_00000200a60fae30;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "bcd";
    .port_info 1 /OUTPUT 4 "excess_3";
L_00000200a6199858 .functor BUFT 1, C4<0011>, C4<0>, C4<0>, C4<0>;
v00000200a61168a0_0 .net/2u *"_ivl_0", 3 0, L_00000200a6199858;  1 drivers
v00000200a60fa890_0 .net "bcd", 3 0, v00000200a6148d70_0;  1 drivers
v00000200a6148e10_0 .net "excess_3", 3 0, L_00000200a6148550;  alias, 1 drivers
L_00000200a6148550 .arith/sum 4, v00000200a6148d70_0, L_00000200a6199858;
    .scope S_00000200a60fae30;
T_0 ;
    %vpi_call 2 24 "$dumpfile", "bcd_to_excess_3_dataflow_tb.vcd" {0 0 0};
    %vpi_call 2 25 "$dumpvars", 32'sb00000000000000000000000000000000, S_00000200a60fae30 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v00000200a6148eb0_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v00000200a6149130_0, 0, 32;
    %vpi_call 2 30 "$display", "===============================================" {0 0 0};
    %vpi_call 2 31 "$display", "      BCD-to-Excess-3 Converter Test          " {0 0 0};
    %vpi_call 2 32 "$display", "===============================================" {0 0 0};
    %vpi_call 2 33 "$display", "Formula: Excess-3 = BCD + 3" {0 0 0};
    %vpi_call 2 34 "$display", "Testing all valid BCD digits from 0 to 9...\012" {0 0 0};
    %vpi_call 2 35 "$display", "Time\011Test\011BCD(dec)\011BCD\011Excess-3\011Expected" {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v00000200a6148690_0, 0, 32;
T_0.0 ;
    %load/vec4 v00000200a6148690_0;
    %cmpi/s 10, 0, 32;
    %jmp/0xz T_0.1, 5;
    %load/vec4 v00000200a6148690_0;
    %pad/s 4;
    %store/vec4 v00000200a6148d70_0, 0, 4;
    %delay 1000, 0;
    %load/vec4 v00000200a6148690_0;
    %addi 3, 0, 32;
    %pad/s 4;
    %store/vec4 v00000200a61485f0_0, 0, 4;
    %load/vec4 v00000200a6148eb0_0;
    %addi 1, 0, 32;
    %store/vec4 v00000200a6148eb0_0, 0, 32;
    %vpi_call 2 44 "$display", "%0t\011%0d\011%0d\011\011%b\011%b\011\011%b", $time, v00000200a6148eb0_0, v00000200a6148690_0, v00000200a6148d70_0, v00000200a6148b90_0, v00000200a61485f0_0 {0 0 0};
    %load/vec4 v00000200a6148b90_0;
    %load/vec4 v00000200a61485f0_0;
    %cmp/ne;
    %jmp/0xz  T_0.2, 6;
    %vpi_call 2 49 "$display", "  FAIL: BCD=%0d (%b), Expected Excess-3=%b, Got=%b", v00000200a6148690_0, v00000200a6148d70_0, v00000200a61485f0_0, v00000200a6148b90_0 {0 0 0};
    %load/vec4 v00000200a6149130_0;
    %addi 1, 0, 32;
    %store/vec4 v00000200a6149130_0, 0, 32;
T_0.2 ;
    %load/vec4 v00000200a6148690_0;
    %addi 1, 0, 32;
    %store/vec4 v00000200a6148690_0, 0, 32;
    %jmp T_0.0;
T_0.1 ;
    %load/vec4 v00000200a6149130_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_0.4, 4;
    %vpi_call 2 56 "$display", "\012PASS: %0d/%0d BCD-to-Excess-3 tests completed successfully.", v00000200a6148eb0_0, v00000200a6148eb0_0 {0 0 0};
    %jmp T_0.5;
T_0.4 ;
    %vpi_call 2 59 "$display", "\012FAIL: %0d of %0d tests failed.", v00000200a6149130_0, v00000200a6148eb0_0 {0 0 0};
    %vpi_call 2 60 "$fatal", 32'sb00000000000000000000000000000001 {0 0 0};
T_0.5 ;
    %vpi_call 2 63 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "bcd_to_excess_3_dataflow_tb.v";
    "bcd_to_excess_3_dataflow.v";
