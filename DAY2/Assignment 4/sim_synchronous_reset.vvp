T_0.5 ;
    %end;
S_000001c520f560d0 .scope module, "dut" "up_down_counter_synchronous_reset" 2 16, 3 6 0, S_000001c520f3ac50;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /INPUT 1 "up";
    .port_info 3 /OUTPUT 4 "count";
v000001c520f7e0f0_0 .net "clk", 0 0, v000001c520f7ee10_0;  1 drivers
v000001c520f7ea50_0 .var "count", 3 0;
v000001c520f7e550_0 .net "reset", 0 0, v000001c520f7e190_0;  1 drivers
v000001c520f7e2d0_0 .net "up", 0 0, v000001c520f7ed70_0;  1 drivers
E_000001c520f7cec0 .event posedge, v000001c520f7e0f0_0;
    .scope S_000001c520f560d0;
T_1 ;
    %wait E_000001c520f7cec0;
    %load/vec4 v000001c520f7e550_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v000001c520f7ea50_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v000001c520f7e2d0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.2, 8;
    %load/vec4 v000001c520f7ea50_0;
    %addi 1, 0, 4;
    %assign/vec4 v000001c520f7ea50_0, 0;
    %jmp T_1.3;
T_1.2 ;
    %load/vec4 v000001c520f7ea50_0;
    %subi 1, 0, 4;
    %assign/vec4 v000001c520f7ea50_0, 0;
T_1.3 ;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_000001c520f3ac50;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v000001c520f7ee10_0;
    %inv;
    %store/vec4 v000001c520f7ee10_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_000001c520f3ac50;
T_3 ;
    %vpi_call 2 50 "$dumpfile", "4_bit_up_down_synchronous_reset_tb.vcd" {0 0 0};
    %vpi_call 2 51 "$dumpvars", 32'sb00000000000000000000000000000000, S_000001c520f3ac50 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001c520f7ee10_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001c520f7e190_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001c520f7ed70_0, 0, 1;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001c520f7e230_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001c520f7dfb0_0, 0, 32;
    %vpi_call 2 59 "$display", "====================================================" {0 0 0};
    %vpi_call 2 60 "$display", " Synchronous Reset 4-bit Up/Down Counter Test     " {0 0 0};
    %vpi_call 2 61 "$display", "====================================================" {0 0 0};
    %wait E_000001c520f7cec0;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v000001c520f7e730_0, 0, 4;
    %fork TD_up_down_counter_synchronous_reset_tb.check_count, S_000001c520f3ade0;
    %join;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001c520f7ed70_0, 0, 1;
    %wait E_000001c520f7cec0;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v000001c520f7e730_0, 0, 4;
    %fork TD_up_down_counter_synchronous_reset_tb.check_count, S_000001c520f3ade0;
    %join;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001c520f7e190_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001c520f7ed70_0, 0, 1;
    %vpi_call 2 72 "$display", "\012Testing all 16 UP COUNT states..." {0 0 0};
    %pushi/vec4 1, 0, 32;
    %store/vec4 v000001c520f7eb90_0, 0, 32;
T_3.0 ;
    %load/vec4 v000001c520f7eb90_0;
    %cmpi/s 16, 0, 32;
    %flag_or 5, 4;
    %jmp/0xz T_3.1, 5;
    %wait E_000001c520f7cec0;
    %load/vec4 v000001c520f7eb90_0;
    %parti/s 4, 0, 2;
    %store/vec4 v000001c520f7e730_0, 0, 4;
    %fork TD_up_down_counter_synchronous_reset_tb.check_count, S_000001c520f3ade0;
    %join;
    %load/vec4 v000001c520f7eb90_0;
    %addi 1, 0, 32;
    %store/vec4 v000001c520f7eb90_0, 0, 32;
    %jmp T_3.0;
T_3.1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001c520f7ed70_0, 0, 1;
    %vpi_call 2 79 "$display", "\012Testing all 16 DOWN COUNT states..." {0 0 0};
    %pushi/vec4 15, 0, 32;
    %store/vec4 v000001c520f7eb90_0, 0, 32;
T_3.2 ;
    %load/vec4 v000001c520f7eb90_0;
    %cmpi/s 0, 0, 32;
    %flag_inv 5; GE is !LT
    %jmp/0xz T_3.3, 5;
    %wait E_000001c520f7cec0;
    %load/vec4 v000001c520f7eb90_0;
    %parti/s 4, 0, 2;
    %store/vec4 v000001c520f7e730_0, 0, 4;
    %fork TD_up_down_counter_synchronous_reset_tb.check_count, S_000001c520f3ade0;
    %join;
    %load/vec4 v000001c520f7eb90_0;
    %subi 1, 0, 32;
    %store/vec4 v000001c520f7eb90_0, 0, 32;
    %jmp T_3.2;
T_3.3 ;
    %load/vec4 v000001c520f7dfb0_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_3.4, 4;
    %vpi_call 2 86 "$display", "\012PASS: %0d/%0d synchronous-reset tests passed.", v000001c520f7e230_0, v000001c520f7e230_0 {0 0 0};
    %jmp T_3.5;
T_3.4 ;
    %vpi_call 2 89 "$fatal", 32'sb00000000000000000000000000000001, "FAIL: %0d of %0d tests failed.", v000001c520f7dfb0_0, v000001c520f7e230_0 {0 0 0};
T_3.5 ;
    %vpi_call 2 92 "$finish" {0 0 0};
    %end;
    .thread T_3;
