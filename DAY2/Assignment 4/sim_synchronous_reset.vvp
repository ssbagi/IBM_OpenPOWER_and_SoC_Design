S_000001c520f3ade0 .scope task, "check_count" "check_count" 2 25, 2 25 0, S_000001c520f3ac50;
 .timescale -9 -12;
v000001c520f7e730_0 .var "expected_count", 3 0;
TD_up_down_counter_synchronous_reset_tb.check_count ;
    %delay 1000, 0;
    %load/vec4 v000001c520f7e230_0;
    %addi 1, 0, 32;
    %store/vec4 v000001c520f7e230_0, 0, 32;
    %load/vec4 v000001c520f7e190_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 1398361667, 0, 32; draw_string_vec4
    %pushi/vec4 542262611, 0, 32; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %pushi/vec4 17748, 0, 16; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %store/vec4 v000001c520f7ecd0_0, 0, 80;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v000001c520f7ed70_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %pushi/vec4 21840, 0, 32; draw_string_vec4
    %pushi/vec4 541282133, 0, 32; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %pushi/vec4 20052, 0, 16; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %store/vec4 v000001c520f7ecd0_0, 0, 80;
    %jmp T_0.3;
T_0.2 ;
    %pushi/vec4 1146050382, 0, 32; draw_string_vec4
    %pushi/vec4 541282133, 0, 32; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %pushi/vec4 20052, 0, 16; draw_string_vec4
    %concat/vec4; draw_string_vec4
    %store/vec4 v000001c520f7ecd0_0, 0, 80;
T_0.3 ;
T_0.1 ;
    %load/vec4 v000001c520f7e870_0;
    %load/vec4 v000001c520f7e730_0;
    %cmp/ne;
    %jmp/0xz  T_0.4, 6;
    %vpi_call 2 39 "$display", "FAIL: Test %0d | %s | Expected=%b | Got=%b", v000001c520f7e230_0, v000001c520f7ecd0_0, v000001c520f7e730_0, v000001c520f7e870_0 {0 0 0};
    %load/vec4 v000001c520f7dfb0_0;
